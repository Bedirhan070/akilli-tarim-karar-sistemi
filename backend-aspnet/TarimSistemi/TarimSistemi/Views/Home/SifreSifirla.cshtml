@{
    Layout = null;
    ViewData["Title"] = "Şifre sıfırlama";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Şifre sıfırlama - Akıllı Tarım</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #1a3c2e 0%, #2d5a42 50%, #4caf50 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .auth-card {
            background: white;
            border-radius: 16px;
            padding: 40px 36px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
        }
        .auth-card h2 { font-size: 1.35rem; font-weight: 800; color: #1a3c2e; margin-bottom: 6px; }
        .auth-card .subtitle { color: #888; font-size: 0.88rem; margin-bottom: 22px; }
        .form-label { font-size: 0.85rem; font-weight: 600; color: #555; }
        .form-control { border-radius: 8px; border: 1.5px solid #ddd; padding: 10px 14px; }
        .form-control:focus { border-color: #4caf50; box-shadow: 0 0 0 3px rgba(76,175,80,0.15); }
        .btn-auth {
            background: linear-gradient(135deg, #2e7d32, #4caf50);
            border: none; border-radius: 8px; padding: 11px; font-weight: 600;
            font-size: 0.95rem; color: white; width: 100%; transition: all 0.2s;
        }
        .btn-auth:hover { color: white; transform: translateY(-1px); box-shadow: 0 5px 15px rgba(76,175,80,0.4); }
        .input-icon-wrap { position: relative; }
        .input-icon-wrap i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #bbb; font-size: 0.85rem; z-index: 2; }
        .input-icon-wrap .form-control { padding-left: 36px; }
        .input-icon-wrap.input-password-wrap .form-control { padding-right: 42px; }
        .btn-toggle-sifre {
            position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
            border: none; background: transparent; color: #888; padding: 6px 10px; cursor: pointer; border-radius: 8px;
        }
        .btn-toggle-sifre:hover { color: #2e7d32; background: rgba(46,125,50,0.08); }
    </style>
</head>
<body>
    <div class="auth-card">
        <!-- Adım 1: E-posta -->
        <div id="adim1">
            <h2><i class="fas fa-unlock-alt text-success me-2"></i>Şifremi unuttum</h2>
            <p class="subtitle">Kayıtlı e-posta adresinizi girin; 6 haneli sıfırlama kodu gönderelim.</p>
            <div id="msgIstek" class="alert d-none py-2 small" role="alert"></div>
            <form id="formIstek">
                <div class="mb-3">
                    <label class="form-label" for="eposta">E-posta</label>
                    <div class="input-icon-wrap">
                        <i class="fas fa-envelope"></i>
                        <input type="email" class="form-control" id="eposta" placeholder="ornek@mail.com" required autocomplete="email" />
                    </div>
                </div>
                <button type="submit" class="btn btn-auth mb-2" id="btnIstekGonder">
                    <i class="fas fa-paper-plane me-2"></i>Kod gönder
                </button>
            </form>
        </div>

        <!-- Adım 2: Kod + yeni şifre (kayıt sonrası gösterilir) -->
        <div id="adim2" class="d-none">
            <h2><i class="fas fa-key text-success me-2"></i>Yeni şifre</h2>
            <p class="subtitle">E-postanıza gönderilen 6 haneli kodu ve yeni şifrenizi girin.</p>
            <div class="alert alert-success py-2 mb-3 small">
                <strong>Kod gönderildi!</strong> Gelen kutusu ve spam klasörünü kontrol edin.
            </div>
            <div class="text-center mb-3">
                <span id="sayacBadge" class="badge bg-success px-3 py-2" style="font-size:0.85rem;">
                    <i class="fas fa-clock me-1"></i>Kodun geçerlilik süresi: <span id="sayacSure">1:00</span>
                </span>
            </div>
            <div id="msgSifir" class="alert d-none py-2 small" role="alert"></div>
            <form id="formSifir">
                <div class="mb-3">
                    <label class="form-label">Doğrulama Kodu</label>
                    <input type="text" class="form-control text-center fw-bold"
                           id="sifirlamaKodu" maxlength="6" placeholder="_ _ _ _ _ _"
                           style="font-size:1.6rem;letter-spacing:8px;" autocomplete="one-time-code" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Yeni şifre</label>
                    <div class="input-icon-wrap input-password-wrap">
                        <i class="fas fa-lock"></i>
                        <input type="password" class="form-control" id="yeniSifre" placeholder="Min. 6 karakter" required minlength="6" autocomplete="new-password" />
                        <button type="button" class="btn-toggle-sifre" aria-label="Şifreyi göster"><i class="fas fa-eye"></i></button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Yeni şifre (tekrar)</label>
                    <div class="input-icon-wrap input-password-wrap">
                        <i class="fas fa-lock"></i>
                        <input type="password" class="form-control" id="yeniSifre2" placeholder="Tekrar girin" required minlength="6" autocomplete="new-password" />
                        <button type="button" class="btn-toggle-sifre" aria-label="Şifreyi göster"><i class="fas fa-eye"></i></button>
                    </div>
                </div>
                <button type="submit" class="btn btn-auth mb-2" id="btnSifirKaydet">
                    <i class="fas fa-check-circle me-2"></i>Şifreyi kaydet
                </button>
            </form>
            <div class="text-center mt-2" id="yenileWrap">
                <button type="button" class="btn btn-link btn-sm text-muted p-0" id="btnKodYenile">
                    Kod gelmedi veya süresi doldu, tekrar gönder
                </button>
                <span id="yenileSonuc" class="small ms-2 text-muted"></span>
            </div>
        </div>

        <div class="text-center mt-3">
            <a href="/Home/Login" class="small text-success fw-semibold text-decoration-none">
                <i class="fas fa-arrow-left me-1"></i>Girişe dön
            </a>
        </div>
    </div>

    <script>
        var _sifirlamaEmail = '';
        var _sayacInterval = null;

        function baslatSayac() {
            clearInterval(_sayacInterval);
            var badge = document.getElementById('sayacBadge');
            var yenileBtn = document.getElementById('btnKodYenile');
            var yenileWrap = document.getElementById('yenileWrap');
            var kalan = 60;

            function guncelleBadge() {
                var sn = kalan % 60;
                var sure = document.getElementById('sayacSure');
                if (sure) sure.textContent = Math.floor(kalan / 60) + ':' + (sn < 10 ? '0' + sn : sn);
                if (kalan <= 10) {
                    badge.className = 'badge bg-danger px-3 py-2';
                } else if (kalan <= 30) {
                    badge.className = 'badge bg-warning text-dark px-3 py-2';
                } else {
                    badge.className = 'badge bg-success px-3 py-2';
                }
            }

            badge.className = 'badge bg-success px-3 py-2';
            badge.innerHTML = '<i class="fas fa-clock me-1"></i>Kodun geçerlilik süresi: <span id="sayacSure">1:00</span>';

            _sayacInterval = setInterval(function () {
                kalan--;
                if (kalan <= 0) {
                    clearInterval(_sayacInterval);
                    badge.className = 'badge bg-danger px-3 py-2';
                    badge.innerHTML = '<i class="fas fa-times-circle me-1"></i>Kod süresi doldu! Yeni kod isteyin.';
                    yenileBtn.classList.replace('text-muted', 'text-danger');
                    yenileWrap.style.fontWeight = '600';
                } else {
                    guncelleBadge();
                }
            }, 1000);
        }

        document.getElementById('formIstek').addEventListener('submit', async function (e) {
            e.preventDefault();
            var el = document.getElementById('msgIstek');
            var btn = document.getElementById('btnIstekGonder');
            el.classList.add('d-none');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Gönderiliyor...';

            _sifirlamaEmail = document.getElementById('eposta').value.trim();

            try {
                var r = await fetch('/api/Auth/sifremi-unuttum', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: _sifirlamaEmail })
                });
                var d = await r.json();
                if (r.ok) {
                    document.getElementById('adim1').classList.add('d-none');
                    document.getElementById('adim2').classList.remove('d-none');
                    document.getElementById('sifirlamaKodu').focus();
                    baslatSayac();
                } else {
                    el.className = 'alert alert-danger py-2 small';
                    el.textContent = d.message || 'İstek gönderilemedi.';
                    el.classList.remove('d-none');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Kod gönder';
                }
            } catch {
                el.className = 'alert alert-danger py-2 small';
                el.textContent = 'Sunucuya bağlanılamadı.';
                el.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Kod gönder';
            }
        });

        document.getElementById('sifirlamaKodu').addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 6);
        });

        document.getElementById('formSifir').addEventListener('submit', async function (e) {
            e.preventDefault();
            var el = document.getElementById('msgSifir');
            var btn = document.getElementById('btnSifirKaydet');
            var kod = document.getElementById('sifirlamaKodu').value.trim();
            var a = document.getElementById('yeniSifre').value;
            var b = document.getElementById('yeniSifre2').value;
            el.classList.add('d-none');

            if (kod.length !== 6) {
                el.className = 'alert alert-warning py-2 small';
                el.textContent = '6 haneli kodu eksiksiz girin.';
                el.classList.remove('d-none');
                return;
            }
            if (a !== b) {
                el.className = 'alert alert-warning py-2 small';
                el.textContent = 'Şifreler eşleşmiyor.';
                el.classList.remove('d-none');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...';

            try {
                var r = await fetch('/api/Auth/sifre-sifirla', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: _sifirlamaEmail, kod: kod, yeniSifre: a })
                });
                var d = await r.json();
                if (r.ok) {
                    el.className = 'alert alert-success py-2 small';
                    el.textContent = d.message || 'Şifreniz güncellendi. Yönlendiriliyorsunuz...';
                    el.classList.remove('d-none');
                    document.getElementById('formSifir').classList.add('d-none');
                    document.getElementById('yenileWrap').classList.add('d-none');
                    setTimeout(function () { window.location.href = '/Home/Login'; }, 1800);
                } else {
                    el.className = 'alert alert-danger py-2 small';
                    el.textContent = (d.message || 'İşlem başarısız.') + ' Yeni kod için aşağıdaki butona tıklayın.';
                    el.classList.remove('d-none');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Şifreyi kaydet';
                    document.getElementById('yenileWrap').style.fontWeight = '600';
                    document.getElementById('btnKodYenile').classList.replace('text-muted', 'text-danger');
                }
            } catch {
                el.className = 'alert alert-danger py-2 small';
                el.textContent = 'Sunucuya bağlanılamadı.';
                el.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Şifreyi kaydet';
            }
        });

        document.getElementById('btnKodYenile').addEventListener('click', async function () {
            var sonuc = document.getElementById('yenileSonuc');
            var yenileBtn = document.getElementById('btnKodYenile');
            sonuc.textContent = 'Gönderiliyor...';
            yenileBtn.disabled = true;
            try {
                var r = await fetch('/api/Auth/sifremi-unuttum', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: _sifirlamaEmail })
                });
                var d = await r.json();
                sonuc.textContent = d.message || (r.ok ? 'Kod gönderildi.' : 'İşlem başarısız.');
                if (r.ok) {
                    yenileBtn.classList.replace('text-danger', 'text-muted');
                    document.getElementById('yenileWrap').style.fontWeight = '';
                    document.getElementById('msgSifir').classList.add('d-none');
                    document.getElementById('sifirlamaKodu').value = '';
                    document.getElementById('sifirlamaKodu').focus();
                    baslatSayac();
                }
            } catch {
                sonuc.textContent = 'İstek gönderilemedi.';
            }
            yenileBtn.disabled = false;
        });

        document.querySelectorAll('.btn-toggle-sifre').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var wrap = btn.closest('.input-password-wrap');
                var input = wrap && wrap.querySelector('input');
                var icon = btn.querySelector('i');
                if (!input || !icon) return;
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.replace('fa-eye', 'fa-eye-slash');
                    btn.setAttribute('aria-label', 'Şifreyi gizle');
                } else {
                    input.type = 'password';
                    icon.classList.replace('fa-eye-slash', 'fa-eye');
                    btn.setAttribute('aria-label', 'Şifreyi göster');
                }
            });
        });
    </script>
</body>
</html>
