@{
    ViewData["Title"] = "Bildirimler";
    ViewData["ActivePage"] = "bildirimler";
}

<style>
    .dash-page { max-width: 900px; margin: 0 auto; }

    .dash-hero {
        background: linear-gradient(125deg, #e3f2fd 0%, #fff 45%, #e8f5e9 100%);
        border: 1px solid #bbdefb;
        border-radius: 18px;
        padding: 22px 26px;
        margin-bottom: 22px;
        box-shadow: 0 8px 28px rgba(21,101,192,0.07);
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }
    .dash-hero-ikon {
        width: 48px; height: 48px; border-radius: 12px;
        background: #e3f2fd; color: #229ED9;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; flex-shrink: 0;
    }
    .dash-hero h1 { font-size: 1.4rem; font-weight: 800; color: #0d47a1; margin: 0 0 6px; }
    .dash-hero p { margin: 0; color: #4a5a7a; font-size: 0.92rem; line-height: 1.5; }

    .tg-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid rgba(26,60,46,0.1);
        box-shadow: 0 4px 22px rgba(20,40,30,0.06);
        padding: 24px 26px;
    }
    .tg-card-head {
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 2px solid #e3f2fd;
        padding-bottom: 14px;
        margin-bottom: 18px;
    }
    .tg-card-head h2 {
        font-size: 1.05rem;
        font-weight: 800;
        color: #1a3a6e;
        margin: 0;
    }
</style>

<div class="dash-page">

    <div class="dash-hero">
        <div class="dash-hero-ikon"><i class="fab fa-telegram-plane"></i></div>
        <div>
            <h1>Bildirimler</h1>
            <p>Tarlalarınızda kritik risk oluştuğunda Telegram üzerinden anında bildirim alın. Günlük özet raporu da aktif edebilirsiniz.</p>
        </div>
    </div>

    <div class="tg-card">
        <div class="tg-card-head">
            <h2><i class="fab fa-telegram-plane me-2" style="color:#229ED9;"></i>Telegram Bildirimleri</h2>
            <span id="tgBagliBadge" class="badge bg-success d-none" style="font-size:0.78rem;">Bağlı ✓</span>
            <span id="tgBagliDegilBadge" class="badge bg-secondary" style="font-size:0.78rem;">Bağlı değil</span>
        </div>

        <div id="telegramAlert" class="alert d-none mb-3 small" role="alert"></div>

        <!-- Bağlı değil -->
        <div id="tgSeksiyon_Baglanma">
            <p class="small text-muted mb-3">Tarlalarınızda kritik risk oluştuğunda Telegram'dan anında haber alın.</p>

            <!-- Adımlar -->
            <div class="d-flex flex-column gap-2 mb-3">
                <div class="d-flex align-items-center gap-3 p-2 rounded" style="background:#f8f9fa;">
                    <span class="badge rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width:28px;height:28px;font-size:0.85rem;">1</span>
                    <span class="small">Aşağıdaki <strong>"Telegram'ı Bağla"</strong> butonuna tıklayın</span>
                </div>
                <div class="d-flex align-items-center gap-3 p-2 rounded" style="background:#f8f9fa;">
                    <span class="badge rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width:28px;height:28px;font-size:0.85rem;">2</span>
                    <span class="small">Açılan sayfada <strong>"Telegram'da Aç"</strong> butonuna basın</span>
                </div>
                <div class="d-flex align-items-center gap-3 p-2 rounded" style="background:#f8f9fa;">
                    <span class="badge rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width:28px;height:28px;font-size:0.85rem;">3</span>
                    <span class="small">Telegram'da karşınıza çıkan <strong>mavi "Başlat"</strong> butonuna basın — bağlantı tamamdır</span>
                </div>
            </div>

            <button class="btn btn-primary fw-bold" id="btnTelegramBagla">
                <i class="fab fa-telegram-plane me-1"></i> Telegram'ı Bağla
            </button>
            <div id="tgLinkAlani" class="alert alert-info small mt-3 d-none" style="border-radius:10px;">
                <div class="fw-bold mb-2"><i class="fas fa-check-circle me-1 text-success"></i>Link hazır!</div>
                <div class="mb-2">Telegram açılacak — orada <strong>mavi "Başlat" butonuna</strong> basın. Hepsi bu kadar.</div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <a id="tgDeepLink" href="#" target="_blank" class="btn btn-sm btn-primary">
                        <i class="fab fa-telegram-plane me-1"></i> Telegram'da Aç
                    </a>
                    <button class="btn btn-sm btn-outline-success" id="btnTgBaglandiYenile">
                        <i class="fas fa-check me-1"></i> Bağlandım
                    </button>
                </div>
                <div class="text-muted mt-2" style="font-size:0.78rem;">Bu link 30 dakika geçerlidir.</div>
            </div>
            <details class="mt-3">
                <summary class="small text-muted" style="cursor:pointer; user-select:none;">
                    Manuel Chat ID girişi <span class="text-muted">(ileri düzey)</span>
                </summary>
                <div class="row g-2 align-items-end mt-2">
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold small" for="inpTelegramChatId">Chat ID</label>
                        <input type="text" class="form-control" id="inpTelegramChatId"
                               placeholder="Örnek: 123456789" maxlength="50" />
                        <div class="form-text">
                            ID'nizi öğrenmek için <a href="https://t.me/userinfobot" target="_blank">@@userinfobot</a>'a mesaj gönderin.
                        </div>
                    </div>
                    <div class="col-sm-auto">
                        <button class="btn btn-outline-success fw-bold px-4" id="btnTelegramKaydet">
                            <i class="fas fa-save me-1"></i> Kaydet
                        </button>
                    </div>
                </div>
            </details>
        </div>

        <!-- Bağlı -->
        <div id="tgSeksiyon_Bagli" class="d-none">
            <p class="small text-muted mb-3">
                Bildirimler aktif. Tarlalarınızda kritik risk oluştuğunda Telegram'dan haber alırsınız.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary px-3" id="btnTelegramTest">
                    <i class="fab fa-telegram-plane me-1"></i> Test mesajı gönder
                </button>
                <button class="btn btn-outline-success px-3" id="btnTelegramGunluk">
                    <i class="fas fa-sun me-1"></i> Günlük raporu şimdi al
                </button>
                <button class="btn btn-outline-danger px-3 ms-auto" id="btnTelegramKes">
                    <i class="fas fa-unlink me-1"></i> Bağlantıyı kes
                </button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
    (function () {
        const authHeaders = () => ({
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + localStorage.getItem('token')
        });

        const tlAlert = document.getElementById('telegramAlert');
        function showTlAlert(kind, text) {
            tlAlert.className = 'alert alert-' + kind + ' mb-3 small';
            tlAlert.textContent = text;
            tlAlert.classList.remove('d-none');
        }

        function tgDurumGuncelle(chatId) {
            const bagli = !!chatId;
            document.getElementById('tgBagliBadge').classList.toggle('d-none', !bagli);
            document.getElementById('tgBagliDegilBadge').classList.toggle('d-none', bagli);
            document.getElementById('tgSeksiyon_Baglanma').classList.toggle('d-none', bagli);
            document.getElementById('tgSeksiyon_Bagli').classList.toggle('d-none', !bagli);
            if (!bagli) document.getElementById('tgLinkAlani').classList.add('d-none');
        }

        async function durumYukle() {
            try {
                const res = await fetch('/api/Auth/profil', { headers: authHeaders() });
                if (res.status === 401) {
                    localStorage.removeItem('token');
                    window.location.href = '/Home/Login';
                    return;
                }
                if (!res.ok) return;
                const p = await res.json();
                document.getElementById('inpTelegramChatId').value = p.telegramChatId || '';
                tgDurumGuncelle(p.telegramChatId);
            } catch {}
        }

        document.getElementById('btnTelegramBagla').addEventListener('click', async function () {
            this.disabled = true;
            const orijinal = this.innerHTML;
            this.innerHTML = 'Link hazırlanıyor…';
            try {
                const res = await fetch('/api/Auth/telegram/baglama-linki', { headers: authHeaders() });
                const data = await res.json().catch(() => ({}));
                if (res.ok && data.link) {
                    document.getElementById('tgDeepLink').href = data.link;
                    document.getElementById('tgLinkAlani').classList.remove('d-none');
                } else {
                    showTlAlert('danger', data.message || 'Link oluşturulamadı.');
                }
            } finally {
                this.disabled = false;
                this.innerHTML = orijinal;
            }
        });

        document.getElementById('btnTgBaglandiYenile').addEventListener('click', async function () {
            await durumYukle();
        });

        document.getElementById('btnTelegramKaydet').addEventListener('click', async function () {
            const chatId = document.getElementById('inpTelegramChatId').value.trim();
            const res = await fetch('/api/Auth/telegram', {
                method: 'PUT',
                headers: authHeaders(),
                body: JSON.stringify({ chatId: chatId || null })
            });
            const data = await res.json().catch(() => ({}));
            showTlAlert(res.ok ? 'success' : 'danger', data.message || (res.ok ? 'Kaydedildi.' : 'Hata.'));
            if (res.ok) await durumYukle();
        });

        document.getElementById('btnTelegramTest').addEventListener('click', async function () {
            showTlAlert('secondary', 'Gönderiliyor…');
            const res = await fetch('/api/Auth/telegram/test', { method: 'POST', headers: authHeaders() });
            const data = await res.json().catch(() => ({}));
            showTlAlert(res.ok ? 'success' : 'danger', data.message || (res.ok ? 'Mesaj gönderildi.' : 'Hata.'));
        });

        document.getElementById('btnTelegramGunluk').addEventListener('click', async function () {
            showTlAlert('secondary', 'Günlük rapor hazırlanıyor…');
            this.disabled = true;
            try {
                const res = await fetch('/api/Auth/telegram/test-gunluk', { method: 'POST', headers: authHeaders() });
                const data = await res.json().catch(() => ({}));
                showTlAlert(res.ok ? 'success' : 'danger', data.message || (res.ok ? 'Rapor gönderildi.' : 'Hata.'));
            } finally {
                this.disabled = false;
            }
        });

        document.getElementById('btnTelegramKes').addEventListener('click', async function () {
            if (!confirm('Telegram bağlantısını kesmek istediğinize emin misiniz?')) return;
            const res = await fetch('/api/Auth/telegram', {
                method: 'PUT',
                headers: authHeaders(),
                body: JSON.stringify({ chatId: null })
            });
            const data = await res.json().catch(() => ({}));
            showTlAlert(res.ok ? 'success' : 'danger', data.message || (res.ok ? 'Bağlantı kesildi.' : 'Hata.'));
            if (res.ok) await durumYukle();
        });

        durumYukle();
    })();
</script>
}
