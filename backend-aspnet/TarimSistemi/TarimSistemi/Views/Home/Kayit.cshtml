@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol - Akıllı Tarım Sistemi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #1a3c2e 0%, #2d5a42 50%, #4caf50 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .auth-card {
            background: white;
            border-radius: 16px;
            padding: 45px 40px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.25);
        }

        .auth-logo {
            text-align: center;
            margin-bottom: 25px;
        }

        .auth-logo i {
            font-size: 2rem;
            color: #4caf50;
        }

        .auth-logo h2 {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1a3c2e;
            margin-top: 8px;
            margin-bottom: 3px;
        }

        .auth-logo .subtitle {
            color: #888;
            font-size: 0.85rem;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #555;
        }

        .form-control {
            border-radius: 8px;
            border: 1.5px solid #ddd;
            padding: 10px 14px;
            font-size: 0.9rem;
        }

        .form-control:focus {
            border-color: #4caf50;
            box-shadow: 0 0 0 3px rgba(76,175,80,0.15);
        }

        .input-icon-wrap {
            position: relative;
        }

        .input-icon-wrap i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #bbb;
            font-size: 0.85rem;
            z-index: 10;
        }

        .input-icon-wrap .form-control {
            padding-left: 36px;
        }

        .input-icon-wrap.input-password-wrap .form-control {
            padding-right: 42px;
        }

        .btn-toggle-sifre {
            position: absolute;
            right: 4px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #888;
            padding: 6px 10px;
            cursor: pointer;
            line-height: 1;
            border-radius: 8px;
        }

        .btn-toggle-sifre:hover {
            color: #2e7d32;
            background: rgba(46, 125, 50, 0.08);
        }

        .btn-auth {
            background: linear-gradient(135deg, #2e7d32, #4caf50);
            border: none;
            border-radius: 8px;
            padding: 11px;
            font-weight: 600;
            font-size: 0.95rem;
            color: white;
            width: 100%;
            transition: all 0.2s;
        }

        .btn-auth:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(76,175,80,0.4);
            color: white;
        }

        .row-form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <i class="fas fa-leaf"></i>
            <h2>Akıllı Tarım Sistemi</h2>
            <p class="subtitle">Yeni hesap oluşturun</p>
        </div>

        <div id="errorMessage" class="alert alert-danger d-none py-2" style="font-size:0.85rem;"></div>

        <!-- Adım 2: Kod doğrulama (kayıt sonrası gösterilir) -->
        <div id="kodPaneli" class="d-none">
            <div class="alert alert-success py-2 mb-3" style="font-size:0.85rem;">
                <strong>Kod gönderildi!</strong> E-postanıza 6 haneli doğrulama kodu gönderdik.
                Gelen kutusu ve spam klasörünü kontrol edin.
            </div>
            <div class="text-center mb-3">
                <span id="sayacBadge" class="badge bg-success px-3 py-2" style="font-size:0.85rem;">
                    <i class="fas fa-clock me-1"></i>Kodun geçerlilik süresi: <span id="sayacSure">1:00</span>
                </span>
            </div>
            <div class="mb-3">
                <label class="form-label">Doğrulama Kodu</label>
                <input type="text" class="form-control text-center fw-bold"
                       id="dogrulamaKodu" maxlength="6" placeholder="_ _ _ _ _ _"
                       style="font-size:1.6rem;letter-spacing:8px;" autocomplete="one-time-code" />
            </div>
            <div id="kodError" class="alert alert-danger d-none py-2 mb-2" style="font-size:0.85rem;"></div>
            <button type="button" class="btn btn-auth mb-2" id="btnDogrula">
                <i class="fas fa-check-circle me-2"></i>Doğrula ve Giriş Yap
            </button>
            <div class="text-center mt-2" id="yenileWrap">
                <button type="button" class="btn btn-link btn-sm text-muted p-0" id="btnKodYenile">
                    Kod gelmedi veya süresi doldu, tekrar gönder
                </button>
                <span id="yenileSonuc" class="small ms-2 text-muted"></span>
            </div>
        </div>

        <form id="kayitForm">
            <div class="mb-3">
                <label class="form-label">Ad Soyad</label>
                <div class="input-icon-wrap">
                    <i class="fas fa-user"></i>
                    <input type="text" class="form-control" id="adSoyad" placeholder="Adınız Soyadınız" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">E-posta</label>
                <div class="input-icon-wrap">
                    <i class="fas fa-envelope"></i>
                    <input type="email" class="form-control" id="email" placeholder="ornek@mail.com" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Telefon <span class="text-muted fw-normal">(opsiyonel)</span></label>
                <div class="input-icon-wrap">
                    <i class="fas fa-phone"></i>
                    <input type="tel" class="form-control" id="telefon" placeholder="5551234567" />
                </div>
            </div>

            <div class="row-form mb-3">
                <div>
                    <label class="form-label">Şifre</label>
                    <div class="input-icon-wrap input-password-wrap">
                        <i class="fas fa-lock"></i>
                        <input type="password" class="form-control" id="sifre" placeholder="Min. 6 karakter" required minlength="6" autocomplete="new-password" />
                        <button type="button" class="btn-toggle-sifre" aria-label="Şifreyi göster" title="Şifreyi göster">
                            <i class="fas fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div>
                    <label class="form-label">Şifre Tekrar</label>
                    <div class="input-icon-wrap input-password-wrap">
                        <i class="fas fa-lock"></i>
                        <input type="password" class="form-control" id="sifreTekrar" placeholder="Tekrar girin" required minlength="6" autocomplete="new-password" />
                        <button type="button" class="btn-toggle-sifre" aria-label="Şifreyi göster" title="Şifreyi göster">
                            <i class="fas fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-auth mb-3">
                <i class="fas fa-user-plus me-2"></i>Kayıt Ol
            </button>
        </form>

        <div class="text-center" style="font-size:0.85rem;">
            <span class="text-muted">Zaten hesabın var mı?</span>
            <a href="/Home/Login" class="text-success fw-bold text-decoration-none ms-1">Giriş Yap</a>
            <div class="mt-2"><a href="/Home/Login" class="text-muted small">Doğrulama e-postası gelmediyse giriş sayfasından yeniden isteyebilirsiniz.</a></div>
        </div>
    </div>

    <script>
        document.getElementById('kayitForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.submitter;

            const sifre = document.getElementById('sifre').value;
            const sifreTekrar = document.getElementById('sifreTekrar').value;
            const errEl = document.getElementById('errorMessage');

            errEl.classList.add('d-none');

            if (sifre !== sifreTekrar) {
                errEl.textContent = 'Şifreler eşleşmiyor';
                errEl.classList.remove('d-none');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...';

            try {
                const response = await fetch('/api/Auth/kayit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        adSoyad: document.getElementById('adSoyad').value,
                        email: document.getElementById('email').value,
                        sifre,
                        telefon: document.getElementById('telefon').value || null
                    })
                });

                const data = await response.json();

                if (response.ok) {
                    document.getElementById('kayitForm').classList.add('d-none');
                    document.getElementById('kodPaneli').classList.remove('d-none');
                    document.getElementById('dogrulamaKodu').focus();
                    baslatSayac();
                } else if (response.status === 409) {
                    errEl.textContent = data.message + ' Giriş sayfasına yönlendiriliyorsunuz...';
                    errEl.classList.remove('d-none');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Yönlendiriliyor...';
                    setTimeout(function () { window.location.href = '/Home/Login'; }, 2000);
                } else {
                    errEl.textContent = data.message;
                    errEl.classList.remove('d-none');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-user-plus me-2"></i>Kayıt Ol';
                }
            } catch {
                errEl.textContent = 'Sunucuya bağlanılamadı';
                errEl.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-user-plus me-2"></i>Kayıt Ol';
            }
        });

        var _kayitEmail = '';
        var _sayacInterval = null;

        function baslatSayac() {
            clearInterval(_sayacInterval);
            var badge = document.getElementById('sayacBadge');
            var yenileBtn = document.getElementById('btnKodYenile');
            var yenileWrap = document.getElementById('yenileWrap');
            var kalan = 60;

            function guncelleBadge() {
                var sn = kalan % 60;
                var sure = document.getElementById('sayacSure');
                if (sure) sure.textContent = Math.floor(kalan / 60) + ':' + (sn < 10 ? '0' + sn : sn);
                if (kalan <= 10) {
                    badge.className = 'badge bg-danger px-3 py-2';
                } else if (kalan <= 30) {
                    badge.className = 'badge bg-warning text-dark px-3 py-2';
                } else {
                    badge.className = 'badge bg-success px-3 py-2';
                }
            }

            badge.className = 'badge bg-success px-3 py-2';
            badge.innerHTML = '<i class="fas fa-clock me-1"></i>Kodun geçerlilik süresi: <span id="sayacSure">1:00</span>';

            _sayacInterval = setInterval(function () {
                kalan--;
                if (kalan <= 0) {
                    clearInterval(_sayacInterval);
                    badge.className = 'badge bg-danger px-3 py-2';
                    badge.innerHTML = '<i class="fas fa-times-circle me-1"></i>Kod süresi doldu! Yeni kod isteyin.';
                    yenileBtn.classList.replace('text-muted', 'text-danger');
                    yenileWrap.style.fontWeight = '600';
                } else {
                    guncelleBadge();
                }
            }, 1000);
        }

        document.getElementById('kayitForm').addEventListener('submit', function (e) {
            _kayitEmail = document.getElementById('email').value.trim();
        });

        document.getElementById('btnDogrula').addEventListener('click', async function () {
            var kod = document.getElementById('dogrulamaKodu').value.trim();
            var errEl = document.getElementById('kodError');
            errEl.classList.add('d-none');

            if (kod.length !== 6) {
                errEl.textContent = '6 haneli kodu eksiksiz girin.';
                errEl.classList.remove('d-none');
                return;
            }

            var btn = this;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Doğrulanıyor...';

            try {
                var r = await fetch('/api/Auth/email-dogrula', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: _kayitEmail, kod: kod })
                });
                var d = await r.json();
                if (r.ok) {
                    btn.innerHTML = '<i class="fas fa-check me-2"></i>Doğrulandı! Yönlendiriliyorsunuz...';
                    setTimeout(function () { window.location.href = '/Home/Login'; }, 1200);
                } else {
                    errEl.textContent = (d.message || 'Kod doğrulanamadı.') + ' Yeni kod için aşağıdaki butona tıklayın.';
                    errEl.classList.remove('d-none');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Doğrula ve Giriş Yap';
                    document.getElementById('yenileWrap').style.fontWeight = '600';
                    document.getElementById('btnKodYenile').classList.replace('text-muted', 'text-danger');
                }
            } catch {
                errEl.textContent = 'Sunucuya bağlanılamadı.';
                errEl.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle me-2"></i>Doğrula ve Giriş Yap';
            }
        });

        document.getElementById('dogrulamaKodu').addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 6);
        });

        document.getElementById('btnKodYenile').addEventListener('click', async function () {
            var sonuc = document.getElementById('yenileSonuc');
            var yenileBtn = document.getElementById('btnKodYenile');
            sonuc.textContent = 'Gönderiliyor...';
            yenileBtn.disabled = true;
            try {
                var r = await fetch('/api/Auth/email-dogrulama-yenile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: _kayitEmail })
                });
                var d = await r.json();
                sonuc.textContent = d.message || (r.ok ? 'Kod gönderildi.' : 'İşlem başarısız.');
                if (r.ok) {
                    yenileBtn.classList.replace('text-danger', 'text-muted');
                    document.getElementById('yenileWrap').style.fontWeight = '';
                    document.getElementById('kodError').classList.add('d-none');
                    document.getElementById('dogrulamaKodu').value = '';
                    document.getElementById('dogrulamaKodu').focus();
                    baslatSayac();
                }
            } catch {
                sonuc.textContent = 'İstek gönderilemedi.';
            }
            yenileBtn.disabled = false;
        });

        document.querySelectorAll('.btn-toggle-sifre').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var wrap = btn.closest('.input-password-wrap');
                if (!wrap) return;
                var input = wrap.querySelector('input');
                var icon = btn.querySelector('i');
                if (!input || !icon) return;
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.replace('fa-eye', 'fa-eye-slash');
                    btn.setAttribute('aria-label', 'Şifreyi gizle');
                    btn.setAttribute('title', 'Şifreyi gizle');
                } else {
                    input.type = 'password';
                    icon.classList.replace('fa-eye-slash', 'fa-eye');
                    btn.setAttribute('aria-label', 'Şifreyi göster');
                    btn.setAttribute('title', 'Şifreyi göster');
                }
            });
        });
    </script>
</body>
</html>
